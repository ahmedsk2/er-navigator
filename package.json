{
  "name": "er-navigator",
  "version": "0.1.0",
  "private": true,
  "description": "ER Navigator Tracker: mobile-first board for ED patients whose stay is running long (Qatif Central Hospital).",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "build:worker": "esbuild worker/alerts.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/worker.js --log-level=warning",
    "build:demo-seed": "esbuild scripts/demo-seed.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/demo-seed.js --log-level=warning",
    "start": "next start",
    "worker": "tsx worker/alerts.ts",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "^16.3.3",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "mysql2": "^3.23.1",
      "uuid": "^11.1.1"
    }
  }
}
