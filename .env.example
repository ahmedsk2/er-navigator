# ER Navigator — environment. Copy to .env for local dev. Production values live ONLY in
# Coolify (application → Environment Variables); never commit real values.

# --- database (docker-compose.production.yml builds the URLs from these) ---
POSTGRES_DB=ernav
POSTGRES_USER=ernav_owner
POSTGRES_PASSWORD=change-me-48-chars-alphanumeric-no-dollar-signs
APP_DB_USER=ernav_app
APP_DB_PASSWORD=change-me-48-chars-alphanumeric-no-dollar-signs
# Local dev only (compose builds this in production):
DATABASE_URL=postgresql://ernav_owner:change-me@localhost:5432/ernav?schema=public

# --- app ---
APP_URL=http://localhost:3000
# The line at the top of the printed report (/report).
REPORT_HEADER=Qatif Central Hospital, Emergency Department. ER Navigator
# (The display timezone, Asia/Riyadh, is fixed in code. Sessions are opaque database tokens:
# there is no signing secret.)

# --- first ADMIN user, consumed by the seed once (change the password after first login) ---
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
ADMIN_PASSWORD=

# --- threshold alerts worker (Phase 6) ---
# How often the worker scans the open cases.
ALERT_INTERVAL_MINUTES=5
# Who gets the 6h+ emails is NOT configured here: it is the active SUPERVISOR and ADMIN users
# that have an email address on their user record (Admin -> Users), read from the database on
# every cycle. Phase 7 replaced the ALERT_EMAIL_MAP directory with that column.
# The file the worker touches after every SUCCESSFUL cycle; the container healthcheck reads it.
ALERT_HEARTBEAT_FILE=/tmp/heartbeat
# Uptime Kuma push monitor URL, GET after every successful cycle. Empty = no external monitor.
ALERT_PUSH_URL=

# Outgoing mail for those alerts. Empty SMTP_HOST = the message is logged, never sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ER Navigator <no-reply@towardpcc.com>
